# Firebase web app config (Console → Project settings → Your apps → Web).
# Copy to .env.local for local dev; add the same vars in Vercel → Settings →
# Environment Variables for the deployed app. Without these the app runs in
# localStorage-only mode (still fully functional on one device).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
